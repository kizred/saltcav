{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kizred/saltcav/schema/saltcav-config.schema.json",
  "$defs": {
    "CalibParamConfig": {
      "additionalProperties": false,
      "description": "Калибруемый параметр и его априорное распределение.\n\nlognormal — медиана = значение из конфигурации, ``log_sd`` — σ ln; uniform —\nравномерно в [low, high]. Пустые поля берутся по умолчанию для параметра.",
      "properties": {
        "name": {
          "description": "Параметр: k0, roof_ratio, floor_ratio, exponent, insoluble_fraction, bulking_factor, k_variation, entrainment_coeff",
          "pattern": "^(k0|roof_ratio|floor_ratio|exponent|insoluble_fraction|bulking_factor|k_variation|entrainment_coeff)$",
          "title": "Name",
          "type": "string"
        },
        "prior": {
          "anyOf": [
            {
              "pattern": "^(lognormal|uniform)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Априорное: lognormal, uniform",
          "title": "Prior"
        },
        "log_sd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lognormal: σ ln вокруг значения из конфигурации",
          "title": "Log Sd"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "uniform: нижняя граница",
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "uniform: верхняя граница",
          "title": "High"
        }
      },
      "required": [
        "name"
      ],
      "title": "CalibParamConfig",
      "type": "object"
    },
    "CalibrationConfig": {
      "additionalProperties": false,
      "description": "Байесовская калибровка по данным скважины (этап 8, saltcav calibrate).\n\nНевязки: концентрация рассола на выходе (σ из brine.csv или ``sigma_concentration``)\nи радиусы сонарных съёмок (``sigma_radius_m``) — в них входит и погрешность модели.",
      "properties": {
        "parameters": {
          "description": "Что подбирать (по умолчанию k0, roof_ratio, insoluble_fraction)",
          "items": {
            "$ref": "#/$defs/CalibParamConfig"
          },
          "title": "Parameters",
          "type": "array"
        },
        "sigma_concentration_kg_m3": {
          "default": 5.0,
          "description": "Погрешность концентрации рассола, кг/м³",
          "exclusiveMinimum": 0,
          "title": "Sigma Concentration Kg M3",
          "type": "number"
        },
        "sigma_radius_m": {
          "default": 0.5,
          "description": "Погрешность радиуса по сонару (вместе с моделью), м",
          "exclusiveMinimum": 0,
          "title": "Sigma Radius M",
          "type": "number"
        },
        "method": {
          "default": "map",
          "description": "map — максимум апостериорной + лапласово приближение; mcmc — emcee",
          "pattern": "^(map|mcmc)$",
          "title": "Method",
          "type": "string"
        },
        "walkers": {
          "default": 16,
          "description": "MCMC: число цепочек (≥ 2 × параметров)",
          "minimum": 4,
          "title": "Walkers",
          "type": "integer"
        },
        "steps": {
          "default": 200,
          "description": "MCMC: шагов каждой цепочки",
          "minimum": 10,
          "title": "Steps",
          "type": "integer"
        },
        "burn": {
          "default": 50,
          "description": "MCMC: отбросить первых шагов",
          "minimum": 0,
          "title": "Burn",
          "type": "integer"
        },
        "n_predictive": {
          "default": 24,
          "description": "Прогонов по апостериорному для полосы прогноза",
          "minimum": 0,
          "title": "N Predictive",
          "type": "integer"
        }
      },
      "title": "CalibrationConfig",
      "type": "object"
    },
    "CreepBranchConfig": {
      "additionalProperties": false,
      "description": "Ветвь установившейся ползучести: ε̇ = A·exp(−Q/RT)·(σ/1 МПа)^n.",
      "properties": {
        "a_per_day": {
          "description": "A, 1/сут (BGRa: 0,18)",
          "exclusiveMinimum": 0,
          "title": "A Per Day",
          "type": "number"
        },
        "n": {
          "description": "Показатель степени n (BGRa: 5)",
          "exclusiveMinimum": 0,
          "title": "N",
          "type": "number"
        },
        "q_kj_per_mol": {
          "description": "Энергия активации Q, кДж/моль (BGRa: 54)",
          "minimum": 0,
          "title": "Q Kj Per Mol",
          "type": "number"
        }
      },
      "required": [
        "a_per_day",
        "n",
        "q_kj_per_mol"
      ],
      "title": "CreepBranchConfig",
      "type": "object"
    },
    "EnsembleConfig": {
      "additionalProperties": false,
      "description": "Ансамбль Монте-Карло (saltcav ensemble).",
      "properties": {
        "n_realizations": {
          "default": 100,
          "description": "Число реализаций по умолчанию",
          "minimum": 1,
          "title": "N Realizations",
          "type": "integer"
        },
        "seed": {
          "default": 12345,
          "description": "Seed: тот же seed — тот же ансамбль бит в бит",
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "sampler": {
          "default": "mc",
          "description": "План: mc — Монте-Карло, lhs — латинский гиперкуб, sobol — Соболь",
          "pattern": "^(mc|lhs|sobol)$",
          "title": "Sampler",
          "type": "string"
        }
      },
      "title": "EnsembleConfig",
      "type": "object"
    },
    "GeologyConfig": {
      "additionalProperties": false,
      "description": "Свойства массива.\n\nДетерминированная неоднородность по азимуту: множитель скорости растворения\nm(φ) = 1 + a·cos(φ − φ₀). Случайные поля по z и φ — в разделе uncertainty.",
      "properties": {
        "insoluble_fraction": {
          "default": 0.05,
          "description": "Доля нерастворимых в породе (объёмная), 0…1",
          "maximum": 1,
          "minimum": 0,
          "title": "Insoluble Fraction",
          "type": "number"
        },
        "insoluble_fraction_sd": {
          "default": 0.0,
          "description": "Ансамбль: ст. отклонение доли нерастворимых (поле)",
          "minimum": 0,
          "title": "Insoluble Fraction Sd",
          "type": "number"
        },
        "bulking_factor": {
          "default": 1.5,
          "description": "Коэффициент разрыхления нерастворимых в насыпи, ≥ 1",
          "minimum": 1,
          "title": "Bulking Factor",
          "type": "number"
        },
        "salt_density_kg_m3": {
          "default": 2160.0,
          "description": "Плотность каменной соли, кг/м³",
          "exclusiveMinimum": 0,
          "title": "Salt Density Kg M3",
          "type": "number"
        },
        "k_variation": {
          "default": 0.0,
          "description": "Асимметрия: амплитуда a в m(φ) = 1 + a·cos(φ − φ₀), 0…1",
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "K Variation",
          "type": "number"
        },
        "k_variation_azimuth_deg": {
          "default": 0.0,
          "description": "Асимметрия: азимут φ₀ быстрого растворения, °",
          "title": "K Variation Azimuth Deg",
          "type": "number"
        },
        "ledge_span_ratio": {
          "default": 3.0,
          "description": "Критический вылет карниза / мощность прослоя",
          "exclusiveMinimum": 0,
          "title": "Ledge Span Ratio",
          "type": "number"
        },
        "layers": {
          "description": "Нерастворимые прослои (ангидрит, глина)",
          "items": {
            "$ref": "#/$defs/LayerConfig"
          },
          "title": "Layers",
          "type": "array"
        }
      },
      "title": "GeologyConfig",
      "type": "object"
    },
    "GridConfig": {
      "additionalProperties": false,
      "description": "Расчётная сетка стенки R(z, φ). Глубина z отсчитывается вниз от поверхности.",
      "properties": {
        "z_top_m": {
          "description": "Глубина верха расчётной сетки, м",
          "exclusiveMinimum": 0,
          "title": "Z Top M",
          "type": "number"
        },
        "z_bottom_m": {
          "description": "Глубина низа сетки, м (глубже z_top_m)",
          "exclusiveMinimum": 0,
          "title": "Z Bottom M",
          "type": "number"
        },
        "nz": {
          "description": "Число слоёв по глубине (шаг = высота / nz)",
          "minimum": 2,
          "title": "Nz",
          "type": "integer"
        },
        "nphi": {
          "default": 1,
          "description": "Число секторов по азимуту; 1 — осесимметрия, 12–36 — 3D",
          "minimum": 1,
          "title": "Nphi",
          "type": "integer"
        },
        "r_borehole_m": {
          "default": 0.15,
          "description": "Начальный радиус ствола скважины, м",
          "exclusiveMinimum": 0,
          "title": "R Borehole M",
          "type": "number"
        }
      },
      "required": [
        "z_top_m",
        "z_bottom_m",
        "nz"
      ],
      "title": "GridConfig",
      "type": "object"
    },
    "LayerConfig": {
      "additionalProperties": false,
      "description": "Прослой; для стохастики задаётся неопределённость положения и мощности.\n\nАнгидрит и глина не растворяются: соль над и под ними уходит, прослой остаётся\nкарнизом. Карниз обрушивается, когда его вылет превышает критический:\n``critical_span_m`` или, если не задан, ``ledge_span_ratio × мощность``.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LayerKind",
          "description": "Порода: anhydrite, clay — не растворяются; halite — соль"
        },
        "top_m": {
          "description": "Глубина кровли прослоя, м",
          "exclusiveMinimum": 0,
          "title": "Top M",
          "type": "number"
        },
        "thickness_m": {
          "description": "Мощность прослоя, м",
          "exclusiveMinimum": 0,
          "title": "Thickness M",
          "type": "number"
        },
        "top_sd_m": {
          "default": 0.0,
          "description": "Ансамбль: ст. отклонение отметки кровли, м",
          "minimum": 0,
          "title": "Top Sd M",
          "type": "number"
        },
        "thickness_sd_m": {
          "default": 0.0,
          "description": "Ансамбль: ст. отклонение мощности, м",
          "minimum": 0,
          "title": "Thickness Sd M",
          "type": "number"
        },
        "critical_span_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Критический вылет карниза, м; пусто — ledge_span_ratio × мощность",
          "title": "Critical Span M"
        }
      },
      "required": [
        "kind",
        "top_m",
        "thickness_m"
      ],
      "title": "LayerConfig",
      "type": "object"
    },
    "LayerKind": {
      "enum": [
        "halite",
        "anhydrite",
        "clay"
      ],
      "title": "LayerKind",
      "type": "string"
    },
    "LeachMode": {
      "enum": [
        "direct",
        "reverse"
      ],
      "title": "LeachMode",
      "type": "string"
    },
    "LeachingConfig": {
      "additionalProperties": false,
      "description": "Параметры закона растворения и численной схемы.\n\nПоток соли со стенки: j = k0 · f(ψ) · C_s · u^n, u = (C_s − C)/C_s.\nk0 по умолчанию подобран по бенчмарку SANSMIC (benchmarks/sansmic): объём камеры\nсовпадает в пределах 1 %. Оценка по корреляции свободной конвекции (Sh ~ Ra^(1/3))\nдаёт 1,5e-5 — тот же порядок. Это априорное значение: калибровать по физической\nмодели и данным компании.",
      "properties": {
        "temperature_c": {
          "default": 30.0,
          "description": "Температура рассола, °C",
          "maximum": 100,
          "minimum": 0,
          "title": "Temperature C",
          "type": "number"
        },
        "k0_m_per_s": {
          "default": 3e-05,
          "description": "Коэффициент растворения k0, м/с (SANSMIC: 3e-5)",
          "exclusiveMinimum": 0,
          "title": "K0 M Per S",
          "type": "number"
        },
        "exponent": {
          "default": 1.3333333333333333,
          "description": "Показатель n в u^n, u — недонасыщение",
          "exclusiveMinimum": 0,
          "title": "Exponent",
          "type": "number"
        },
        "roof_ratio": {
          "default": 1.5,
          "description": "Скорость растворения кровли / вертикальной стенки",
          "minimum": 0,
          "title": "Roof Ratio",
          "type": "number"
        },
        "floor_ratio": {
          "default": 0.0,
          "description": "Скорость растворения подошвы / вертикальной стенки",
          "minimum": 0,
          "title": "Floor Ratio",
          "type": "number"
        },
        "initial_saturation": {
          "default": 1.0,
          "description": "Начальное насыщение рассола в скважине C₀/C_s",
          "maximum": 1,
          "minimum": 0,
          "title": "Initial Saturation",
          "type": "number"
        },
        "plume": {
          "default": true,
          "description": "Струя и плюм от башмака закачки; false — мгновенное перемешивание",
          "title": "Plume",
          "type": "boolean"
        },
        "entrainment_coeff": {
          "default": 0.09,
          "description": "Коэффициент вовлечения плюма α (SANSMIC: 0,09)",
          "maximum": 0.5,
          "minimum": 0,
          "title": "Entrainment Coeff",
          "type": "number"
        },
        "tubing_radius_m": {
          "default": 0.1,
          "description": "Внутренний радиус колонны закачки, м",
          "exclusiveMinimum": 0,
          "title": "Tubing Radius M",
          "type": "number"
        },
        "cfl": {
          "default": 0.5,
          "description": "Число Куранта для движения стенки",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Cfl",
          "type": "number"
        },
        "max_growth_fraction": {
          "default": 0.5,
          "description": "Ограничение шага: прирост объёма ≤ доля·Q·dt",
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Max Growth Fraction",
          "type": "number"
        },
        "dt_max_days": {
          "default": 1.0,
          "description": "Наибольший шаг по времени, сут",
          "exclusiveMinimum": 0,
          "title": "Dt Max Days",
          "type": "number"
        },
        "output_every_days": {
          "default": 10.0,
          "description": "Сохранять результаты каждые N сут (кадры просмотра)",
          "exclusiveMinimum": 0,
          "title": "Output Every Days",
          "type": "number"
        }
      },
      "title": "LeachingConfig",
      "type": "object"
    },
    "MechanicsConfig": {
      "additionalProperties": false,
      "description": "Геомеханика: МКЭ вокруг формы камеры на выбранный момент, ползучесть соли.\n\nМодель axisym — осесимметрия по эквивалентному радиусу √(среднее R²) (секунды);\n3d — полная форма R(z, φ) на тетраэдрах (минуты).",
      "properties": {
        "day": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Момент формы, сут; пусто — конец выщелачивания",
          "title": "Day"
        },
        "model": {
          "default": "axisym",
          "description": "axisym — осесимметрия по эквивалентному радиусу (секунды); 3d — полная форма R(z, φ), тетраэдры (минуты, нужен pypardiso)",
          "pattern": "^(axisym|3d)$",
          "title": "Model",
          "type": "string"
        },
        "h_wall_3d_m": {
          "default": 3.0,
          "description": "3D: размер элемента у стенки, м",
          "exclusiveMinimum": 0,
          "title": "H Wall 3D M",
          "type": "number"
        },
        "h_wall_m": {
          "default": 1.0,
          "description": "Размер элемента у стенки, м",
          "exclusiveMinimum": 0,
          "title": "H Wall M",
          "type": "number"
        },
        "r_min_m": {
          "default": 0.5,
          "description": "Радиус, ниже которого сечение считается массивом, м",
          "exclusiveMinimum": 0,
          "title": "R Min M",
          "type": "number"
        },
        "r_factor": {
          "default": 8.0,
          "description": "Внешний радиус области / наибольший радиус камеры",
          "exclusiveMinimum": 1,
          "title": "R Factor",
          "type": "number"
        },
        "height_factor": {
          "default": 3.0,
          "description": "Запас области сверху и снизу / размер камеры",
          "exclusiveMinimum": 0,
          "title": "Height Factor",
          "type": "number"
        },
        "outer": {
          "default": "free",
          "description": "Внешняя граница: free — одиночная камера, roller — ряд камер (ячейка)",
          "pattern": "^(free|roller)$",
          "title": "Outer",
          "type": "string"
        },
        "cell_radius_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Радиус ячейки (половина расстояния между камерами) для roller",
          "title": "Cell Radius M"
        },
        "youngs_modulus_gpa": {
          "default": 25.0,
          "description": "Модуль Юнга соли, ГПа",
          "exclusiveMinimum": 0,
          "title": "Youngs Modulus Gpa",
          "type": "number"
        },
        "poisson": {
          "default": 0.25,
          "description": "Коэффициент Пуассона",
          "exclusiveMaximum": 0.5,
          "exclusiveMinimum": 0,
          "title": "Poisson",
          "type": "number"
        },
        "overburden_density_kg_m3": {
          "default": 2300.0,
          "description": "Средняя плотность пород над камерой, кг/м³",
          "exclusiveMinimum": 0,
          "title": "Overburden Density Kg M3",
          "type": "number"
        },
        "surface_temperature_c": {
          "default": 10.0,
          "description": "Температура на поверхности, °C",
          "title": "Surface Temperature C",
          "type": "number"
        },
        "geothermal_gradient_c_per_km": {
          "default": 30.0,
          "description": "Геотермический градиент, °C/км",
          "minimum": 0,
          "title": "Geothermal Gradient C Per Km",
          "type": "number"
        },
        "creep": {
          "description": "Ветви установившейся ползучести (сумма); по умолчанию BGRa",
          "items": {
            "$ref": "#/$defs/CreepBranchConfig"
          },
          "title": "Creep",
          "type": "array"
        },
        "transient": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransientConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Неустановившаяся ползучесть Мансона–Доусона; null — выключить"
        },
        "stages": {
          "description": "Ступени давления в камере по порядку",
          "items": {
            "$ref": "#/$defs/PressureStageConfig"
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        },
        "output_every_years": {
          "default": 1.0,
          "description": "Сохранять каждые N лет",
          "exclusiveMinimum": 0,
          "title": "Output Every Years",
          "type": "number"
        },
        "dilatancy_coeff": {
          "default": 0.27,
          "description": "Критерий дилатансии √J2 = a·I1 (Ratigan: 0,27)",
          "exclusiveMinimum": 0,
          "title": "Dilatancy Coeff",
          "type": "number"
        },
        "step_tolerance": {
          "default": 0.1,
          "description": "Изменение девиатора напряжений за шаг, доля",
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "title": "Step Tolerance",
          "type": "number"
        }
      },
      "title": "MechanicsConfig",
      "type": "object"
    },
    "PressureStageConfig": {
      "additionalProperties": false,
      "description": "Ступень эксплуатации камеры после выщелачивания.",
      "properties": {
        "duration_years": {
          "description": "Длительность, лет",
          "exclusiveMinimum": 0,
          "title": "Duration Years",
          "type": "number"
        },
        "wellhead_pressure_mpa": {
          "default": 0.0,
